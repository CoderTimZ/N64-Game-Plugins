{
	"authors": [
		"CoderTim"
	],
	"name": "n64-game-plugins",
	"dependencies": {
		"vibe-d": "~>0.10.3"
	},
	"libs-windows": ["user32"],
	"stringImportPaths": ["textures"],
	"configurations": [
    {
      "name": "mp1",
      "targetType": "dynamicLibrary",
      "targetName": "MarioParty1",
      "sourceFiles": ["plugin.d", "marioparty.d", "marioparty1.d"]
    },
    {
      "name": "mp2",
      "targetType": "dynamicLibrary",
      "targetName": "MarioParty2",
      "sourceFiles": ["plugin.d", "marioparty.d", "marioparty2.d"]
    },
    {
      "name": "mp3",
      "targetType": "dynamicLibrary",
      "targetName": "MarioParty3",
      "sourceFiles": ["plugin.d", "marioparty.d", "marioparty3.d"]
    },
    {
      "name": "mp1-test",
      "targetType": "dynamicLibrary",
      "targetName": "MarioParty1",
      "targetPath": "test-build",
      "versions": ["TestDriver"],
      "sourceFiles": ["plugin.d", "marioparty.d", "marioparty1.d", "test/driver.d", "test/mp1test.d"]
    },
    {
      "name": "mp2-test",
      "targetType": "dynamicLibrary",
      "targetName": "MarioParty2",
      "targetPath": "test-build",
      "versions": ["TestDriver"],
      "sourceFiles": ["plugin.d", "marioparty.d", "marioparty2.d", "test/driver.d", "test/mp2test.d"]
    },
    {
      "name": "mg64",
      "targetType": "dynamicLibrary",
      "targetName": "MarioGolf64",
      "sourceFiles": ["plugin.d", "mariogolf.d"]
    }
  ]
}