union Space {
    static enum Type : byte {
        START     = 0x00,
        BLUE      = 0x01,
        RED       = 0x02,
        INVISIBLE = 0x03,
        HAPPENING = 0x04,
        CHANCE    = 0x05,
        ITEM      = 0x06,
        BANK      = 0x07,
        INVIS_2   = 0x08,
        BATTLE    = 0x09,
        UNKNOWN_1 = 0x0A,
        UNKNOWN_2 = 0x0B,
        BOWSER    = 0x0C,
        ARROW     = 0x0D,
        STAR      = 0x0E,
        GAME_GUY  = 0x0F
    }

    ubyte[0x24] _data;
    mixin Field!(0x01, Type, "type");

    bool isSolid() {
        switch (type) {
            case Type.BLUE:
            case Type.RED:
            case Type.HAPPENING:
            case Type.CHANCE:
            case Type.ITEM:
            case Type.BANK:
            case Type.BATTLE:
            case Type.BOWSER:
            case Type.GAME_GUY:
                return true;
            default:
                return false;
        }
    }
}

