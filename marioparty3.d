bool isValid(Item item) {
    return Item.MUSHROOM <= item && item <= Item.WACKY_WATCH;
}

bool isRare(Item item) {
    return Item.KOOPA_KARD <= item && item <= Item.WACKY_WATCH;
}

bool isCommon(Item item) {
    return isValid(item) && !isRare(item);
}

